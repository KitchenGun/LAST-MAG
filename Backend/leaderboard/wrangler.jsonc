{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gulag-leaderboard-smoke",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "vars": {
    "BOARD_VERSION": "smoke-v1",
    "ALLOWED_ORIGINS": "https://kitchengun.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gulag-leaderboard-smoke",
      "database_id": "9c5fd82d-b5cc-41ea-9bac-b2421b351698"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
